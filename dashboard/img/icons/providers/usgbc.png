    <div id="logout-confirm-modal" class="modal fade" role="dialog" style="top:25%;">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-body text-left pl20 pr20">
            <p style="margin-bottom: 15px;">By clicking logout button below, you will be logged out of all the USGBC and GBCI applications in this browser.</p>
            <p style="margin-bottom: 0;">Click the logout button below to continue logging out or cancel button to stay logged in.</p>
          </div>
          <div class="modal-footer">
            <a class="btn btn-primary btn-md nested-modal logout-confirm" href="/user/logout">Logout</a>
            <button type="button" class="btn btn-outline btn-md pull-left" data-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>
    <div class="sso-msg-wrp"><span class="sso-a-info">Logging out the application..</span></div>

