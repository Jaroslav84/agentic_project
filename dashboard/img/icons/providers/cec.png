<script>
  var searchInput = document.getElementById('heroSearch');
  var searchButton = document.getElementById('searchButton');

  function triggerSearch() {
    var searchTerm = searchInput.value.trim();
    if (!searchTerm) return;
    var words = searchTerm.split(" ");
    if (words.length > 10) {
      words = words.filter(
              (word) => !["with", "in", "of", "and", "the", "a"].includes(word.toLowerCase())
      );
      if (words.length > 10) {
        words = words.slice(0, 10);
      }
      if (words.length === 0) {
        return;
      }
    }
    var s = words.map((word) => word.replace(/'/g, "")).join("-");
    if (s && s !== "search-png-images") {
      var t = "/free/" + s + ".html";
      var tag = s + "_user";
      $.get(
              "https://topdata.freepnges.com/cleanpng_hits_process.php?id=" +
              tag + "&hl=cleanpngtag_user"
      );
      window.location.href = t;
    }
  }

  searchInput.addEventListener('keypress', function(event) {
    if (event.key === 'Enter') {
      triggerSearch();
    }
  });

  searchButton.addEventListener('click', function() {
    triggerSearch();
  });

</script>
