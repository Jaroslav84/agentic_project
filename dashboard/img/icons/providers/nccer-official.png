/* FLEX CONTAINER */

 .flex-container {
        display: flex;
        flex-wrap: nowrap; /* Prevent wrapping in larger screens */
        width: 100%;
    }

    .text-cell {
        flex: 3; /* Allocate more space for text */
        padding: 0 !important;
    }

    .image-cell {
        flex: 1; /* Allocate less space for the image */
        padding: 0 !important;
    }

    .responsive-img {
        width: 100%; /* Makes the image responsive */
        height: auto; /* Maintains the aspect ratio */
    }

    @media (max-width: 768px) {
        .flex-container {
            flex-direction: column; /* Stack vertically on smaller screens */
        }

        .text-cell, .image-cell {
            width: 100%; /* Full width on smaller screens */
            margin-bottom: 10px; /* Add some space between them */
        }
    }		</style>
		

